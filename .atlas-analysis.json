{
  "projectType": "cli-tool",
  "projectName": "SearchBench",
  "projectDescription": "An evaluation harness for comparing agent-facing interfaces — such as code-search tools and MCP servers — over benchmark tasks to determine which interface makes coding agents perform better.",
  "theme": "luma",
  "primaryColor": "#2563EB",
  "lightColor": "#DBEAFE",
  "darkColor": "#1E3A8A",
